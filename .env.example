# Server-only admin security. Generate with:
# npm run admin:hash -- "your-strong-admin-password"
ADMIN_PASSWORD_HASH=pbkdf2:sha256:310000:REPLACE_WITH_BASE64_SALT:REPLACE_WITH_BASE64_HASH
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_ROLE=owner
ADMIN_SESSION_MAX_AGE_SECONDS=28800

# Distributed rate limits and trusted TLS ingress (Caddy in docker-compose.yml)
REDIS_URL=redis://redis:6379
TRUST_PROXY=true
TRUSTED_PROXY_HEADER=x-real-ip
SITE_ADDRESS=https://tanvinhdat.vn

# Server-only n8n proxy configuration. Production requires an HTTPS endpoint.
N8N_WEBHOOK_URL=https://your-n8n-domain/webhook/img-extract
N8N_WEBHOOK_SECRET=
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit

# Server-only contact form proxy. CONTACT_WEBHOOK_URL must use HTTPS in production.
CONTACT_WEBHOOK_URL=https://your-n8n-domain/webhook/contact-inquiry
CONTACT_WEBHOOK_SECRET=
