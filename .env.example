# Server-only admin security. Generate with:
# npm run admin:hash -- "your-strong-admin-password"
ADMIN_PASSWORD_HASH=pbkdf2:sha256:310000:REPLACE_WITH_BASE64_SALT:REPLACE_WITH_BASE64_HASH
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_ROLE=owner
ADMIN_SESSION_MAX_AGE_SECONDS=28800

# Server-only n8n proxy configuration
N8N_WEBHOOK_URL=http://localhost:5678/webhook/img-extract
N8N_WEBHOOK_SECRET=
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit

# Public contact form automation endpoint. This value is visible in browser JavaScript.
NEXT_PUBLIC_CONTACT_WEBHOOK_URL=
